{
  // Browser side: the extension code in src/, bundled by esbuild (scripts/build.ts).
  // Node.js side (scripts/, e2e/, *.config.ts) is checked by tsconfig.node.json.
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "types": ["chrome"],

    // No emit; esbuild bundles the sources and keeps .ts imports working (D6)
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    // strict is the default in TypeScript 7; stated to document the intent (D7)
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
