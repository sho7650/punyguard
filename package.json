{
  "name": "punyguard",
  "version": "0.0.0",
  "private": true,
  "description": "Chrome extension that blocks navigation to IDN (xn--) hosts",
  "author": "sho",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "build:watch": "node scripts/build.ts --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run build && playwright test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage"
  },
  "dependencies": {
    "punycode": "^2.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.4",
    "@types/punycode": "^2.1.4",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.3.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "error"
    }
  }
}
